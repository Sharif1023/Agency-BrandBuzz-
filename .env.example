APP_NAME="BrandBuzz"
APP_ENV=production
# Leave blank for automatic subfolder detection. Set your exact domain on a live server.
APP_URL=
APP_TIMEZONE=Asia/Dhaka
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=brandbuzz_agency
DB_USERNAME=root
DB_PASSWORD=
# Generate your private key: php tools/generate-key.php
# Required for the one-time installation. Do not publish or share it.
INSTALL_KEY=
SESSION_TIMEOUT=3600
UPLOAD_MAX_MB=5
